# ═══════════════════════════════════════════════════
#  TorBox Bot — קובץ הגדרות
#  העתק קובץ זה ל-.env ומלא את הערכים
# ═══════════════════════════════════════════════════

# הטוקן של הבוט מ-@BotFather בטלגרם
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# מפתח ה-API של TorBox
# מקבלים אותו ב: https://torbox.app/settings  →  API
TORBOX_API_KEY=your_torbox_api_key_here

# מזהה הטלגרם שלך (הבעלים — מקבל הרשאות מלאות אוטומטית)
# למצוא אותו: שלח הודעה לבוט @userinfobot
OWNER_ID=123456789

# נתיב לבסיס הנתונים (אפשר להשאיר כברירת מחדל)
DB_PATH=torbox_bot.db

BOT_TOKEN=
TORBOX_API_KEY=
OWNER_ID=0

# Unified search: auto merges Prowlarr + TorBox Search when available.
# Use "prowlarr" or "torbox" to force a single provider.
SEARCH_PROVIDER=auto
SEARCH_INCLUDE_TORRENTS=1
SEARCH_INCLUDE_USENET=1
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
PROWLARR_TIMEOUT=25
PROWLARR_LIMIT=60
SEARCH_CONCURRENCY=2

# Permanent public redirect links.
# Point this to your domain/reverse proxy, for example:
# PUBLIC_BASE_URL=https://downloads.example.com
PUBLIC_BASE_URL=
PUBLIC_LINKS_ENABLED=1
PUBLIC_LINK_HOST=0.0.0.0
PUBLIC_LINK_PORT=8080
PUBLIC_LINK_PATH_PREFIX=d
PUBLIC_LINK_RATE_LIMIT_PER_MINUTE=30

# 0 keeps completed downloads in TorBox/AirLock for long-lived links.
# Use a positive number only if you prefer automatic cleanup.
AUTO_DELETE_COMPLETED_AFTER_MINUTES=0
QUEUE_ROTATE_ACTIVE_AFTER_MINUTES=30
